<html>
    <head>
        <title>Sign Up</title>
        <link rel="stylesheet" href="styles3.css">
    </head>
    <body>
        <h1>Sign Up</h1>

        <form action="/try-signup" method="POST">
            <div class="inputsect">
            <label class="acc-label" for="acc-id">User ID</label>
            <input type="text" name="acc-id" required>
            </div>
            <div class="inputsect">
            <label class="acc-label" for="acc-pw">Password</label>
            <input type="text" name="acc-pw" required>
            </div>
            <label class="acc-label" for="acc-un">Name</label>
            <input type="text" name="acc-un" required>
            </div>
            <input id="acc-b" type="submit" value="Sign up"/>
        </form>
    </body>
</html>